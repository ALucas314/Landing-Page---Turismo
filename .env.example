# =====================================================================
# FielTour — modelo de variáveis de ambiente
# Copie este arquivo para ".env" e preencha com os dados do seu projeto
# (Supabase > Project Settings > API). O ".env" NÃO vai para o GitHub.
# =====================================================================

# --- Valores PÚBLICOS (vão para o navegador via assets/js/env.js) ---
# URL do projeto: https://SEU-PROJETO.supabase.co
SUPABASE_URL=
# Chave pública: "anon public" (eyJ...) ou "publishable" (sb_publishable_...)
SUPABASE_ANON_KEY=
# Bucket do Storage com as imagens dos pacotes
SUPABASE_STORAGE_BUCKET=pacotes

# --- Valores PRIVADOS (somente scripts no servidor/computador local) ---
# Chave "service_role" ou "secret" (sb_secret_...). NUNCA use no frontend.
# Necessária apenas para "npm run criar-admin". Pode ficar vazia.
SUPABASE_SERVICE_ROLE_KEY=

# --- Servidor local de desenvolvimento ---
PORT=5500
